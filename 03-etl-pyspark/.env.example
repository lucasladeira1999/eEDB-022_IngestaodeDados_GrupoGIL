POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# nomes dos schemas de cada camada e da tabela final (delivery)
RAW_SCHEMA=raw
TRUSTED_SCHEMA=trusted
