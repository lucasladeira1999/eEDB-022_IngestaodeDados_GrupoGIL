# limiar de similaridade (0-100) do fuzzy match quando nao ha CNPJ/nome exato
FUZZY_SCORE_CUTOFF_RECLAMACOES=80
FUZZY_SCORE_CUTOFF_EMPREGADOS=90

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin