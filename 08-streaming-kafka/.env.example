POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
ETL_PASSWORD=etl

# schema e tabela do cadastro de bancos, consultado no enriquecimento
CADASTRO_SCHEMA=cadastro
CADASTRO_TABELA=bancos

KAFKA_TOPIC=reclamacoes
KAFKA_PARTICOES=3
# de quantos em quantos segundos o Structured Streaming fecha uma janela
JANELA_SEGUNDOS=10

# limiar de similaridade (0-100) do fuzzy match, última tentativa do enriquecimento
FUZZY_SCORE_CUTOFF=80

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
