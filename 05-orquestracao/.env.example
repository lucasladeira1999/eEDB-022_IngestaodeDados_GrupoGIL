# Porta host do Postgres do OpenMetadata
OM_POSTGRES_PORT=5544

# A orquestração inteira (incluindo a ingestão de metadados) já é feita pelo Airflow via CLI (metadata ingest), então esse recurso fica desligado.
PIPELINE_SERVICE_CLIENT_ENABLED=false

# Credenciais de admin usadas para buscar automaticamente um token JWT
OPENMETADATA_ADMIN_EMAIL=admin@open-metadata.org
OPENMETADATA_ADMIN_PASSWORD=admin
